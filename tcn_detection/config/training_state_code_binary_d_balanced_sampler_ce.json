{
  "schema_version": 1,
  "cpu_threads_per_process": 8,
  "batch_size": 256,
  "max_epochs": 80,
  "early_stopping_patience": 12,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "sampling_strategy": "weighted_sampler",
  "loss_type": "cross_entropy",
  "class_weight_strategy": "none",
  "train_class_ratio": {"0": 0.5, "1": 0.5},
  "ordinal_positive_weight_strategy": "none",
  "checkpoint_selection_metric": "critical_pr_auc"
}
