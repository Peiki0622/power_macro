!/delay_chain/ftc/runs/phase_diverse_final/static_transfer.csv
!/delay_chain/ftc/runs/phase_diverse_final/static_summary.json
!/delay_chain/ftc/runs/phase_diverse_final/final_glitch_map.csv
!/delay_chain/ftc/runs/phase_diverse_final/final_glitch_summary.json

# The real-XOR anchor gate is a compact reviewed decision record, not a raw
# simulator product.  Keep this one analysis artifact versionable while the
# associated HSPICE decks, listings, databases, and command logs stay ignored.
!/delay_chain/ftc/analysis/real_xor_pulse_width/anchor_summary.json

# FTC controller run products are reproducible from the checked-in RTL,
# scripts, constraints, and curated reports.  Keep source-level SystemVerilog,
# Python, JSON contracts, Markdown reports, and reviewed netlists visible while
# excluding VCS/EDA compiler databases and waveform products from Git status.
/csrc/
/delay_chain/ftc/controller/**/csrc/

# Corrected Phase 9 XA diagnostic launch directories contain task-scoped
# copies of decks, wrappers, testbenches, and bridge configuration generated
# by the run scripts.  The authored diagnostic deck and compact JSON evidence
# live one level above these directories and remain visible for review.
/delay_chain/ftc/controller/analysis/phase9_autonomous_transistor_level/vcs_xa_corrected/diagnostics/**/run/
/delay_chain/ftc/controller/**/simv*
/delay_chain/ftc/controller/**/*.daidir/
/delay_chain/ftc/controller/**/*.vdb/
/delay_chain/ftc/controller/**/*.vpd
/delay_chain/ftc/controller/**/*.vcd
/delay_chain/ftc/controller/**/*.o
/delay_chain/ftc/controller/**/*.so
/delay_chain/ftc/controller/**/AN.DB/
/delay_chain/ftc/controller/**/alib-*/
/delay_chain/ftc/controller/**/command.log
/delay_chain/ftc/controller/**/default.svf
/delay_chain/ftc/controller/**/ucli.key

# Additional FTC controller simulator products.  These patterns are scoped to
# the controller tree so reviewed reports, source files, and compact evidence
# outside this subsystem remain visible.  FSDB/VPD waveforms, VCS/XA reports,
# logs, databases, and compiled shared objects are reproducible run products.
/delay_chain/ftc/controller/**/*.fsdb
/delay_chain/ftc/controller/**/*.rpt
/delay_chain/ftc/controller/**/*.log
/delay_chain/ftc/controller/**/*.sdb
/delay_chain/ftc/controller/**/*.db
/delay_chain/ftc/controller/**/*.so
/delay_chain/ftc/controller/**/*.o
/delay_chain/ftc/controller/**/*.a
/delay_chain/ftc/controller/**/xa/
/delay_chain/ftc/controller/**/simv
/delay_chain/ftc/controller/**/simv.daidir/
/delay_chain/ftc/controller/**/simv.msv/
/delay_chain/ftc/controller/**/csrc/
