# Python bytecode is interpreter-specific intermediate output, never source.
__pycache__/
*.py[cod]

# Local Python quality tools regenerate these caches from tracked source and
# configuration.  Keeping them out of status prevents test/lint invocations
# from obscuring model, contract, and report changes that require review.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# DC and Library Compiler write these files at the repository root when their
# working directory is not redirected to a task-scoped run.  They are local
# tool caches or transcripts, not design inputs: the real constraints, Tcl
# drivers, source RTL, and curated reports remain version controlled.  These
# are deliberately root-anchored rather than global filename globs so a
# reviewed log or SVF deliberately stored under a source/report directory is
# never hidden by this policy.
/alib-*/
/command.log
/lc_shell_command.log
/default.svf
/ucli.key

# Neural-training checkpoints and TensorBoard event streams are large,
# environment-dependent run products.  Formal runs identify checkpoints by
# SHA256 in versioned Markdown reports; the binary weights remain mounted in
# the workspace and must not be committed even if a future launcher writes
# them outside the already-ignored tcn_detection/runs tree.
*.pt
*.pth
*.ckpt
events.out.tfevents*

# HSPICE creates these beside each generated deck.  Decks, listings, measures,
# solver state and command logs are reproducible task outputs, not source.
*.lis
*.mt0
*.mt0.csv
*.tr0
*.ic0
*.st0
*.pa0
*.ms0
hspice_command.log

# Ignore all direct products of a task-owned delay-chain run: generated decks,
# raw/derived tables, manifests, reports and scenario subdirectories.  Keep
# only curated figures so repository history retains visual experiment evidence
# without accumulating simulator databases and intermediate result artifacts.
/delay_chain/**/runs/*/*
!/delay_chain/**/runs/*/figures/
!/delay_chain/**/runs/*/figures/**

# The Phase-3 wide-range conclusion is independently reviewable from one
# compact code curve and one compact gate summary.  Keep this narrow exception
# while every generated deck, listing, waveform, log, and scenario directory
# remains ignored by the rule above.
!/delay_chain/phase3/runs/wide_range_final/voltage_code.csv
!/delay_chain/phase3/runs/wide_range_final/voltage_summary.json
!/delay_chain/phase3/runs/wide_range_repaired_final/voltage_code.csv
!/delay_chain/phase3/runs/wide_range_repaired_final/voltage_summary.json

# TCN run directories contain generated datasets, simulator products, model
# checkpoints and other reproducible artifacts.  Keep the directory traversal
# visible only so Markdown reports at any nesting depth can be versioned; every
# non-Markdown file beneath this run root remains ignored.
/tcn_detection/runs/**
!/tcn_detection/runs/**/
!/tcn_detection/runs/**/*.md

# Result JSON records are ignored by semantic filename rather than by a
# repository-wide ``*.json`` rule.  Configuration JSON under tcn_detection/
# config remains reviewable source; these patterns only hide generated
# summaries, manifests, provenance, complexity, and quantization reports if a
# launcher writes them outside the normal runs/ directory.
**/*_summary.json
**/*_manifest.json
**/complexity.json
**/validation_metrics.json

# Re-apply the two curated repaired-final evidence exceptions after generic
# generated-summary patterns.  Scenario decks/listings/logs remain ignored.
!/delay_chain/phase3/runs/wide_range_repaired_final/voltage_code.csv
!/delay_chain/phase3/runs/wide_range_repaired_final/voltage_summary.json
# The resolution-repair screen establishes the 25/50 mV acceptance points;
# the matching 83-point curve proves the same selected physical topology over
# the entire range.  Keep only these compact CSV/JSON contracts, never their
# generated decks, listings, waveforms, logs, or scenario directories.
!/delay_chain/phase3/runs/wide_range_resolution_mask_early_late8_screen/voltage_code.csv
!/delay_chain/phase3/runs/wide_range_resolution_mask_early_late8_screen/voltage_summary.json
!/delay_chain/phase3/runs/wide_range_resolution_early_late8_final/voltage_code.csv
!/delay_chain/phase3/runs/wide_range_resolution_early_late8_final/voltage_summary.json
**/*_provenance.json
**/*_report.json
**/channel_importance.json
**/input_manifest.json
**/pruning_paths.json
**/search_manifest.json
**/teacher_contract.json
**/quantization_*.json
**/final_compression.json

# The V1 Pilot corpus was superseded by the corrected, authoritative V2 corpus
# and is explicitly forbidden as a label source by the TCN README.  The two
# top-level split summaries are duplicate pre-audit scratch outputs; canonical
# human-readable audits remain versionable as Markdown beneath runs/.
/tcn_detection/data/corpus_v1.jsonl
/tcn_detection/data/split_audit_v1.json
/tcn_detection/data/split_audit_v2_20260725_r2.json

# Reference Paper
/reference_paper

# FTC keeps only compact, reviewable electrical evidence under its task-owned
# run directories.  Generated decks, listings, waveforms, solver state, and
# command logs remain covered by the generic delay-chain run ignore policy.
!/delay_chain/ftc/
!/delay_chain/ftc/runs/
!/delay_chain/ftc/runs/mechanism_nominal_search/
!/delay_chain/ftc/runs/mechanism_nominal_search/search.csv
!/delay_chain/ftc/runs/mechanism_nominal_search/selection.json
!/delay_chain/ftc/runs/mechanism_coarse/
!/delay_chain/ftc/runs/mechanism_coarse/voltage_xor.csv
!/delay_chain/ftc/runs/mechanism_coarse/summary.json
!/delay_chain/ftc/runs/xor_loading_nominal/
!/delay_chain/ftc/runs/xor_loading_nominal/loading_comparison.json
!/delay_chain/ftc/runs/capture_nominal/
!/delay_chain/ftc/runs/capture_nominal/capture_phase.csv
!/delay_chain/ftc/runs/capture_nominal/selection.json
!/delay_chain/ftc/runs/integrated_coarse/
!/delay_chain/ftc/runs/integrated_coarse/voltage_xor.csv
!/delay_chain/ftc/runs/integrated_coarse/summary.json
!/delay_chain/ftc/runs/integrated_coarse_phase300/
!/delay_chain/ftc/runs/integrated_coarse_phase300/voltage_xor.csv
!/delay_chain/ftc/runs/integrated_coarse_phase300/summary.json
!/delay_chain/ftc/runs/static_fine/
!/delay_chain/ftc/runs/static_fine/static_transfer.csv
!/delay_chain/ftc/runs/static_fine/summary.json
!/delay_chain/ftc/runs/phase_sensitivity/
!/delay_chain/ftc/runs/phase_sensitivity/phase_sensitivity.csv
!/delay_chain/ftc/runs/phase_sensitivity/summary.json
!/delay_chain/ftc/runs/glitch_initial/
!/delay_chain/ftc/runs/glitch_initial/glitch_matrix.csv
!/delay_chain/ftc/runs/glitch_initial/summary.json

# Final FTC worktree policy: simulator/VCS evidence and rendered figures are
# reproducible artifacts, so keep them out of Git status.  The authored
# Markdown reports remain reviewable source documents under reports/.
/delay_chain/ftc/runs/**
/delay_chain/ftc/reports/figures/**
!/delay_chain/ftc/reports/*.md

# Phase-diverse FTC keeps only the compact source evidence needed by the
# post-processing regressions.  Each exception names a task-owned run root;
# generated HSPICE decks, listings, waveforms, command logs, and scenario
# directories remain ignored by the preceding catch-all rule.
!/delay_chain/ftc/runs/phase_diverse_screen/
!/delay_chain/ftc/runs/phase_diverse_screen/phase_candidate_anchor.csv
!/delay_chain/ftc/runs/phase_diverse_screen/phase_candidate_coarse.csv
!/delay_chain/ftc/runs/phase_diverse_screen/phase_candidate_summary.json
!/delay_chain/ftc/runs/phase_diverse_screen/qualified_phases.json
!/delay_chain/ftc/runs/phase_diverse_static/
!/delay_chain/ftc/runs/phase_diverse_static/phase_baselines.json
!/delay_chain/ftc/runs/phase_diverse_static/phase_jitter.csv
!/delay_chain/ftc/runs/phase_diverse_static/phase_jitter_summary.json
!/delay_chain/ftc/runs/phase_diverse_glitch/
!/delay_chain/ftc/runs/phase_diverse_glitch/glitch_phase_map.csv
!/delay_chain/ftc/runs/phase_diverse_glitch/glitch_phase_map_summary.json
!/delay_chain/ftc/runs/phase_diverse_glitch/glitch_phase_map_jitter_aware.csv
